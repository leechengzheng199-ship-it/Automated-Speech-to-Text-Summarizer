{
  "name": "speech-summarizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "cf:build": "node -e \"try{require('fs').rmSync('public/ffmpeg',{recursive:true,force:true})}catch{}\" && opennextjs-cloudflare build",
    "cf:deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && node scripts/copy-ffmpeg.cjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@prisma/adapter-d1": "^6.19.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "mp4box": "^2.4.1",
    "next": "16.3.1",
    "proxy-agent": "^8.0.2",
    "qiniu": "^7.15.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.20.0"
}
